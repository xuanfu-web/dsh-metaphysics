test/_*.mjs
# 但共用断言工具必须入库
!test/_harness.mjs
.DS_Store
fork.json

# 穷通宝鉴抓取缓存（tools/qiongtong-scrape.mjs 生成，不入库）
tools/_qt2.json

# 临时日志（调试时随手重定向出来的）
_*.log
_scan.mjs
_grab.mjs
# 视觉自查截图（无头 Chrome 生成，不入库）
_*.png

# 面板真机回归的临时宿主（tools/e2e-panel.mjs 生成，跑完自删）
_panel-harness.html
_panel-react.js
_panel-client.js

# 自动发布：状态/锁/日志（配置在 ~/.dsh，不入库）
.autopublish-state.json
.autopublish.lock
tools/.autopublish.log
# 上一轮失败留下的标记：存在即说明没跑成，成功后自动删除
tools/.autopublish-error

# 测试用的独立锁（test/autopublish.test.mjs 生成）
.qa-autopublish-test.lock

# 宿主/自动化运行时写入的记忆与状态（本机产物，不入库）
.workbuddy/

# 凭据：发布用的 token 只从 <用户目录>/.dsh 与环境变量喂给脚本。
# 这三行是第一道闸；autopublish 的提交允许清单是第二道（根文件必须有已知扩展名）。
.env
.env.*
.npmrc
*.secret
